        "arguments": "{\"id\":\"FAKE-item-0002\"}"
      },
      {
        "type": "function_call_output",
        "call_id": "FAKE-call-0002",
        "output": "{\"ok\":true}"
      }
    ],
    "tools": [
      {
        "type": "function",
