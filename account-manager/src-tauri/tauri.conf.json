{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Coding Agent Manager",
  "version": "0.1.0",
  "identifier": "dev.metadevelop.coding-agent-manager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Coding Agent Manager",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Account manager for AI coding agents",
    "longDescription": "Manage accounts, credentials, quota, and routing across Claude Code, Codex CLI, Cursor, Grok CLI, Gemini CLI, and other AI coding agents.",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
