# Citation: documented event shapes, not a live capture.
# deepseek-harness 0.2.2-alpha.3
# packages/bundle/headless/README.md section "Machine-readable output"
# packages/bundle/headless/src/json-stream.ts (session, status, thinking, text,
# tool_call, tool_result, final; step_end usage inputTokens/outputTokens and
# optional totalTokens, cacheReadTokens, cacheWriteTokens, reasoningTokens).
# Success is exit 0 and final.reason.kind === "completed". A tool_result status
# of "completed" only means the tool returned.
# Native read input schema: https://github.com/deepseek-ai/deepseek-harness/blob/master/packages/fs/tool-fs/src/read.ts
{"type":"session","sessionId":"session-documented","cwd":"/work"}
{"type":"status","phase":"turn_start","turn":1}
{"type":"status","phase":"step_start","turn":1,"step":1}
{"type":"thinking","text":"inspect the assigned file"}
{"type":"text","text":"inspection complete"}
{"type":"tool_call","callId":"call-1","tool":"read","input":{"file_path":"/work/README.md"}}
{"type":"tool_result","callId":"call-1","status":"completed","result":"contents"}
{"type":"status","phase":"step_end","turn":1,"step":1,"usage":{"inputTokens":11,"outputTokens":7,"cacheReadTokens":3,"reasoningTokens":2}}
{"type":"status","phase":"turn_end","turn":1,"reason":{"kind":"completed"}}
{"type":"final","sessionId":"session-documented","reason":{"kind":"completed"},"text":"inspection complete"}
