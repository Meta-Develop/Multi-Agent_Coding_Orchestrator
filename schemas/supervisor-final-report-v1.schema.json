    "validationResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "status",
        "command"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/reviewStatus"
        },
