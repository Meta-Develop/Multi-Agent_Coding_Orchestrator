        },
        "reviewed_actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reviewedGateAction"
          }
        },
        "gate_lifecycles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/gateCorrectionLifecycle"
          }
        },
