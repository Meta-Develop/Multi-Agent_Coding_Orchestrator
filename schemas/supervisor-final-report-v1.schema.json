            "string",
            "null"
          ]
        },
        "achieved_max_concurrent_children": {
          "type": "integer",
          "minimum": 0
        },
        "achieved_mean_concurrent_children": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "achieved_mean_observation": {
          "$ref": "#/$defs/processObservation"
        },
