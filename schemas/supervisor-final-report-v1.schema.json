            "fd_bound": {
              "type": ["integer", "null"],
              "minimum": 1
            },
            "disk_available_mib": {
              "type": ["integer", "null"],
              "minimum": 1
            },
            "disk_available_source": {
              "$ref": "#/$defs/admissionInputSource"
            },
            "disk_per_child_mib": {
              "type": "integer",
              "minimum": 1
            },
            "disk_bound": {
              "type": ["integer", "null"],
              "minimum": 1
            },
            "fallback_children": {
              "type": "integer",
              "minimum": 1
            },
            "resolved_bound": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
