          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "denial_rate": {
          "$ref": "#/$defs/ratioMetric"
        },
        "self_correction_rate": {
          "$ref": "#/$defs/ratioMetric"
        },
        "interruption_rate": {
