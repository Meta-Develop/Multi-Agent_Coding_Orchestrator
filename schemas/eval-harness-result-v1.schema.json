{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Meta-Develop/Multi-Agent_Coding_Orchestrator/main/schemas/eval-harness-result-v1.schema.json",
  "title": "MACO Eval Harness Result v1",
  "description": "Contract for local fake-provider-backed model-mix harness output. Records the declared mix and per-role FakeProvider outcomes. Network providers are out of scope.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "schema",
    "experiment_id",
    "task",
    "task_digest",
    "provider",
    "runs"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "schema": {
      "type": "string",
      "const": "eval_harness_result_v1"
    },
    "experiment_id": {
      "type": "string",
      "minLength": 1
    },
    "task": {
      "type": "string",
      "minLength": 1
    },
    "task_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "provider": {
      "$ref": "#/$defs/providerClaim"
    },
    "runs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/run"
      }
    }
  },
  "$defs": {
    "providerClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "network_providers"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "const": "local_fake"
        },
        "network_providers": {
          "type": "boolean",
          "const": false
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "mix",
        "outcomes",
        "totals"
      ],
      "properties": {
        "profile_id": {
          "type": "string",
          "minLength": 1
        },
        "mix": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/recordedMix"
          }
        },
        "outcomes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/outcome"
          }
        },
        "totals": {
          "$ref": "#/$defs/usage"
        }
      }
    },
    "recordedMix": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "model"
      ],
      "properties": {
        "role": {
          "$ref": "#/$defs/mixRole"
        },
        "model": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "model",
        "request_id",
        "provider_id",
        "status",
        "usage"
      ],
      "properties": {
        "role": {
          "$ref": "#/$defs/mixRole"
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "provider_id": {
          "type": "string",
          "const": "local_fake"
        },
        "status": {
          "type": "string",
          "enum": [
            "completed",
            "failed"
          ]
        },
        "usage": {
          "$ref": "#/$defs/usage"
        },
        "proposal_summary": {
          "type": "string",
          "minLength": 1
        },
        "error": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "mixRole": {
      "type": "string",
      "enum": [
        "planner",
        "worker",
        "supervisor",
        "auditor"
      ]
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_tokens",
        "output_tokens",
        "total_tokens"
      ],
      "properties": {
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "total_tokens": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
