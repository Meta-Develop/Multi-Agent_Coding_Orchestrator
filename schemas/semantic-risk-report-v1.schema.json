{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Meta-Develop/Multi-Agent_Coding_Orchestrator/main/schemas/semantic-risk-report-v1.schema.json",
  "title": "MACO Semantic Risk Report v1",
  "description": "Contract for `maco repo query risk --json`, including authenticated megafile hotspots.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "changed_paths",
    "touched_files",
    "touched_symbols",
    "dependency_impacts",
    "impacted_files",
    "errors",
    "megafile_hotspots"
  ],
  "properties": {
    "changed_paths": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/repositoryRelativePath"
      }
    },
    "touched_files": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/semanticFile"
      }
    },
    "touched_symbols": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/semanticSymbol"
      }
    },
    "dependency_impacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dependencyImpact"
      }
    },
    "impacted_files": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/repositoryRelativePath"
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/scanError"
      }
    },
    "megafile_hotspots": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/megafileHotspot"
      }
    }
  },
  "$defs": {
    "repositoryRelativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384,
      "pattern": "^[^\\u0000-\\u001F]+$",
      "allOf": [
        {
          "not": {
            "pattern": "^[\\\\/]"
          }
        },
        {
          "not": {
            "pattern": "^[A-Za-z]:"
          }
        },
        {
          "not": {
            "pattern": "(^|[\\\\/])\\.\\.([\\\\/]|$)"
          }
        }
      ],
      "description": "Producer-normalized repository-relative path; native separators remain platform-dependent."
    },
    "nullableRepositoryRelativePath": {
      "anyOf": [
        {
          "$ref": "#/$defs/repositoryRelativePath"
        },
        {
          "type": "null"
        }
      ]
    },
    "sourceSpan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start_byte",
        "end_byte",
        "start_line",
        "end_line",
        "signature_end_line"
      ],
      "properties": {
        "start_byte": {
          "type": "integer",
          "minimum": 0
        },
        "end_byte": {
          "type": "integer",
          "minimum": 0
        },
        "start_line": {
          "type": "integer",
          "minimum": 0
        },
        "end_line": {
          "type": "integer",
          "minimum": 0
        },
        "signature_end_line": {
          "type": "integer",
          "minimum": 0,
          "description": "Last line of the declaration signature, not the body. For Rust this is the line containing `{` or `;`. Live SourceSpan JSON always emits this field."
        }
      }
    },
    "semanticFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "module_path",
        "byte_len",
        "line_count"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/repositoryRelativePath"
        },
        "module_path": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "byte_len": {
          "type": "integer",
          "minimum": 0
        },
        "line_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "semanticSymbol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "file",
        "name",
        "qualified_path",
        "kind",
        "visibility",
        "parent_symbol",
        "impl_target",
        "impl_trait",
        "span"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "file": {
          "$ref": "#/$defs/repositoryRelativePath"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "qualified_path": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "kind": {
          "$ref": "#/$defs/symbolKind"
        },
        "visibility": {
          "type": "string",
          "minLength": 1
        },
        "parent_symbol": {
          "type": [
            "string",
            "null"
          ]
        },
        "impl_target": {
          "type": [
            "string",
            "null"
          ]
        },
        "impl_trait": {
          "type": [
            "string",
            "null"
          ]
        },
        "span": {
          "$ref": "#/$defs/sourceSpan"
        }
      }
    },
    "symbolKind": {
      "type": "string",
      "enum": [
        "module",
        "function",
        "struct",
        "enum",
        "trait",
        "impl",
        "method",
        "const",
        "type_alias"
      ]
    },
    "dependencyImpact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "direction",
        "changed_path",
        "related_file",
        "dependency"
      ],
      "properties": {
        "direction": {
          "type": "string",
          "enum": [
            "incoming",
            "outgoing"
          ]
        },
        "changed_path": {
          "$ref": "#/$defs/repositoryRelativePath"
        },
        "related_file": {
          "$ref": "#/$defs/nullableRepositoryRelativePath"
        },
        "dependency": {
          "$ref": "#/$defs/dependency"
        }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from_file",
        "from_module",
        "to",
        "to_file",
        "kind",
        "span"
      ],
      "properties": {
        "from_file": {
          "$ref": "#/$defs/repositoryRelativePath"
        },
        "from_module": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "to_file": {
          "$ref": "#/$defs/nullableRepositoryRelativePath"
        },
        "kind": {
          "type": "string",
          "enum": [
            "import",
            "module_declaration",
            "inline_module"
          ]
        },
        "span": {
          "$ref": "#/$defs/sourceSpan"
        }
      }
    },
    "scanError": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "kind",
        "message",
        "span"
      ],
      "properties": {
        "file": {
          "$ref": "#/$defs/repositoryRelativePath"
        },
        "kind": {
          "type": "string",
          "enum": [
            "read",
            "parse",
            "unsupported"
          ]
        },
        "message": {
          "type": "string"
        },
        "span": {
          "anyOf": [
            {
              "$ref": "#/$defs/sourceSpan"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "fileSizeSample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "bytes",
        "lines"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/repositoryRelativePath"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "lines": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "megafileSignal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "observed",
        "threshold"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "file_bytes",
            "file_lines",
            "growth_bytes",
            "growth_lines",
            "claim_count",
            "collision_count"
          ]
        },
        "observed": {
          "type": "integer",
          "minimum": 0
        },
        "threshold": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "megafileHotspot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "path",
        "is_megafile",
        "signals",
        "latest_sample",
        "previous_sample",
        "growth_bytes",
        "growth_lines",
        "claims_in_window",
        "collisions_in_window",
        "accepted_decompositions"
      ],
      "properties": {
        "version": {
          "type": "integer",
          "const": 1
        },
        "path": {
          "$ref": "#/$defs/repositoryRelativePath"
        },
        "is_megafile": {
          "const": true
        },
        "signals": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/megafileSignal"
          }
        },
        "latest_sample": {
          "anyOf": [
            {
              "$ref": "#/$defs/fileSizeSample"
            },
            {
              "type": "null"
            }
          ]
        },
        "previous_sample": {
          "anyOf": [
            {
              "$ref": "#/$defs/fileSizeSample"
            },
            {
              "type": "null"
            }
          ]
        },
        "growth_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "growth_lines": {
          "type": "integer",
          "minimum": 0
        },
        "claims_in_window": {
          "type": "integer",
          "minimum": 0
        },
        "collisions_in_window": {
          "type": "integer",
          "minimum": 0
        },
        "accepted_decompositions": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
