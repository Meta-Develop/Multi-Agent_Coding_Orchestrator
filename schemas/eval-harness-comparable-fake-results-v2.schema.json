{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Meta-Develop/Multi-Agent_Coding_Orchestrator/main/schemas/eval-harness-comparable-fake-results-v2.schema.json",
  "title": "MACO Eval Harness Comparable Fake Results v2",
  "description": "Contract for `eval-harness run-v2` / version-2 `eval-harness run` machine-readable output from `execute_v2_local_fake`. Network and real-provider execution are refused.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "schema",
    "experiment_id",
    "manifest_schema",
    "manifest_digest",
    "fixture",
    "provider",
    "objective_profile",
    "objective_citation",
    "runs",
    "profile_summaries",
    "pareto_frontier",
    "objective_selection",
    "comparability",
    "production_eligible",
    "production_default_claim"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 2
    },
    "schema": {
      "type": "string",
      "const": "eval_harness_comparable_fake_results_v2"
    },
    "experiment_id": {
      "type": "string",
      "minLength": 1
    },
    "manifest_schema": {
      "type": "string",
      "const": "eval_harness_manifest_v2"
    },
    "manifest_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "version", "id", "digest"],
      "properties": {
        "schema": { "type": "string", "minLength": 1 },
        "version": { "type": "integer", "minimum": 1 },
        "id": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "network_providers"],
      "properties": {
        "kind": { "type": "string", "const": "local_fake" },
        "network_providers": { "type": "boolean", "const": false }
      }
    },
    "objective_profile": {
      "type": "object"
    },
    "objective_citation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "content_hash", "source"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "integer", "minimum": 1 },
        "content_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "source": {
          "type": "string",
          "enum": ["built_in", "repository_override"]
        }
      }
    },
    "runs": {
      "type": "array",
      "minItems": 1
    },
    "profile_summaries": {
      "type": "array",
      "minItems": 1
    },
    "pareto_frontier": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "objective_selection": {
      "type": "object",
      "required": [
        "profile_id",
        "profile_hash",
        "selected_profile_id",
        "selected_score",
        "scores"
      ],
      "properties": {
        "profile_id": { "type": "string", "minLength": 1 },
        "profile_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "selected_profile_id": { "type": "string", "minLength": 1 },
        "selected_score": { "type": "number" },
        "runner_up_profile_id": { "type": ["string", "null"] },
        "runner_up_score": { "type": ["number", "null"] },
        "scores": { "type": "object" }
      }
    },
    "comparability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "equivalent_initial_state_fingerprint",
        "expected_run_count",
        "validated_run_count",
        "replay_verified"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["comparable", "incomparable"]
        },
        "equivalent_initial_state_fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "expected_run_count": { "type": "integer", "minimum": 1 },
        "validated_run_count": { "type": "integer", "minimum": 1 },
        "replay_verified": { "type": "boolean" }
      }
    },
    "production_eligible": {
      "type": "boolean",
      "const": false
    },
    "production_default_claim": {
      "type": "string",
      "minLength": 1
    }
  }
}
